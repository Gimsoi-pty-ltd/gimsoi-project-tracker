# Gimsoi Project Tracker - backend environment variables
#
# Copy this file to apps/backend/.env and replace the placeholders.
# Never commit .env or share its values in logs, screenshots, or issues.

# -----------------------------------------------------------------------------
# REQUIRED IN EVERY ENVIRONMENT
# -----------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma and the API.
# Prisma Postgres: https://console.prisma.io -> open the database -> Connect.
# Local PostgreSQL: obtain the URL from your local database administrator.
DATABASE_URL=""

# Secret used to sign login tokens. Generate a new value with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=""

# -----------------------------------------------------------------------------
# LOCAL RUNTIME SETTINGS
# -----------------------------------------------------------------------------

# Use "development" locally, "test" only for a disposable test database,
# and "production" in deployed environments.
NODE_ENV=development

# Optional. The API defaults to port 5001 when this is omitted.
PORT=5001

# Frontend origin. Keep this value for the local Vite app.
# Change it to the deployed frontend URL in production.
# Recommended locally; required in production and for correct password-reset URLs.
CLIENT_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------

# Signs stateless CSRF tokens. Development has an internal fallback, but using a
# unique value locally is recommended. This variable is required in production.
# Generate it with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=""

# -----------------------------------------------------------------------------
# EMAIL DELIVERY
# -----------------------------------------------------------------------------

# Optional locally, but required in production. Email verification, welcome,
# and password-reset emails will not work without these values.
#
# GMAIL_USER: the Gmail address that sends application email.
# GMAIL_APP_PASSWORD: create one at
# https://myaccount.google.com/apppasswords after enabling 2-Step Verification.
# Do not use the Gmail account's normal password.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# -----------------------------------------------------------------------------
# OPTIONAL DATABASE POOL TUNING
# -----------------------------------------------------------------------------

# Delete these lines to use the shown defaults.
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=60000

# -----------------------------------------------------------------------------
# OPTIONAL ZOHO PROJECTS INTEGRATION
# -----------------------------------------------------------------------------

# Needed only for /api/zoho/login and /api/zoho/callback.
# Create a server-based application at https://api-console.zoho.com/ and use
# http://localhost:5001/api/zoho/callback as the local redirect URI.
# ZOHO_CLIENT_ID=""
# ZOHO_CLIENT_SECRET=""
# ZOHO_REDIRECT_URI="http://localhost:5001/api/zoho/callback"

# -----------------------------------------------------------------------------
# OPTIONAL SEED-ONLY SETTING
# -----------------------------------------------------------------------------

# Used only by `npx prisma db seed` to create/update the demo account.
# The seed script clears existing domain data. Never run it on shared/production.
# DEMO_PASSWORD=""

# -----------------------------------------------------------------------------
# TEST-ONLY SAFETY SETTINGS
# -----------------------------------------------------------------------------

# The API test suite truncates database tables. Use only a disposable database.
# STRICT_DB_GUARD=true enables the local database-target safety check.
# TEST_DB_IDENTIFIER is needed only to allow a specifically named non-local,
# disposable test database through that guard.
# STRICT_DB_GUARD=true
# TEST_DB_IDENTIFIER="unique-disposable-test-database-name"
